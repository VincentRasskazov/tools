---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% unless page.url contains '.css' or page.url contains '.js' or page.url contains 'google' %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ page.url | replace: '/index.html', '/' }}</loc>
  </url>
{% endunless %}{% endfor %}
</urlset>
