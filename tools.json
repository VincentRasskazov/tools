---
layout: null
---
[
  {% assign has_printed = false %}

  {% comment %} --- PART 1: Process New "Pages" (Files with Front Matter) --- {% endcomment %}
  {% assign page_tools = site.pages | where_exp: "item", "item.url contains '/tools/'" %}
  
  {% for tool in page_tools %}
    {% if tool.url contains '.html' and tool.url != '/tools/tools.json' %}
      {% if has_printed %},{% endif %}
      {
        "name": "{{ tool.title | default: tool.url | split: '/' | last | replace: '.html', '' | replace: '-', ' ' | capitalize }}",
        "url": "{{ site.baseurl }}{{ tool.url }}",
        "category": "{{ tool.category | default: 'Utility' }}",
        "description": "{{ tool.description | default: 'Free online tool.' }}"
      }
      {% assign has_printed = true %}
    {% endif %}
  {% endfor %}

  {% comment %} --- PART 2: Process Old "Static Files" (Files WITHOUT Front Matter) --- {% endcomment %}
  {% assign static_tools = site.static_files | where_exp: "item", "item.path contains '/tools/'" %}

  {% for tool in static_tools %}
    {% if tool.extname == '.html' %}
      {% if has_printed %},{% endif %}
      {
        "name": "{{ tool.basename | replace: '-', ' ' | capitalize }}",
        "url": "{{ site.baseurl }}{{ tool.path }}",
        "category": "Utility",
        "description": "Free online tool."
      }
      {% assign has_printed = true %}
    {% endif %}
  {% endfor %}
]
