---
layout: null
---
[
  {% assign tools = site.static_files | where_exp: "item", "item.path contains '/tools/'" %}
  {% for tool in tools %}
    {% if tool.extname == '.html' %}
    {
      "name": "{{ tool.basename | replace: '-', ' ' | capitalize }}",
      "url": "{{ site.baseurl }}{{ tool.path }}",
      "category": "Utility",
      "description": "Free online tool."
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
