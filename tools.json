---
layout: null
---
[
  {% assign all_tools = "" | split: "" %}
  
  {% comment %} Gather all tools into one array first {% endcomment %}
  {% assign page_tools = site.pages | where_exp: "item", "item.url contains '/tools/'" %}
  {% for tool in page_tools %}
    {% if tool.url contains '.html' and tool.url != '/tools/tools.json' %}
      {% assign all_tools = all_tools | push: tool %}
    {% endif %}
  {% endfor %}

  {% comment %} Loop and print with JSON safety {% endcomment %}
  {% for tool in all_tools %}
    {
      "name": {{ tool.title | default: tool.url | split: '/' | last | replace: '.html', '' | replace: '-', ' ' | capitalize | jsonify }},
      "url": {{ site.baseurl | append: tool.url | jsonify }},
      "category": {{ tool.category | default: 'Utility' | jsonify }},
      "description": {{ tool.description | default: 'Free online tool.' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}

  {% comment %} Handle static files (usually don't have descriptions/titles) {% endcomment %}
  {% assign static_tools = site.static_files | where_exp: "item", "item.path contains '/tools/'" %}
  {% if static_tools.size > 0 %},{% endif %}
  {% for tool in static_tools %}
    {% if tool.extname == '.html' %}
    {
      "name": {{ tool.basename | replace: '-', ' ' | capitalize | jsonify }},
      "url": {{ site.baseurl | append: tool.path | jsonify }},
      "category": "Utility",
      "description": "Free online tool."
    }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
